## Kali Base
podman-kali-base (){
    sudo podman run \
    -it \
    --rm \
    --security-opt label=disable \
    --network host \
    --privileged \
    -v $HOME:$HOME \
    ghcr.io/sir-mudkip/kali-base:latest
}

## Kali-cloud
podman-kali-cloud (){
    sudo podman run \
    --rm \
    --it \
    --security-opt label=disable \
    --network host \
    --privileged \
    -v $HOME:$HOME \
    ghcr.io/sir-mudkip/kali-cloud:latest \
}
